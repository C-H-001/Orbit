{
  "name": "orbit-job-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,blue \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "generate:extension-icons": "tsx extension/scripts/generate-icons.ts",
    "build:extension": "pnpm generate:extension-icons && vite build --config extension/vite.config.ts && tsx scripts/verify-extension-build.ts",
    "build": "pnpm build:web && pnpm build:extension",
    "dev:extension": "vite build --watch --config extension/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p extension/tsconfig.json --noEmit",
    "test": "node --import tsx --test server/tests/*.test.ts",
    "reprocess:html": "tsx server/reprocess-html.ts",
    "rebuild:applications": "tsx server/rebuild-applications.ts",
    "replay:applications": "tsx server/replay-application-analyses.ts",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "html-to-text": "^10.0.1",
    "imapflow": "^1.7.6",
    "lucide-react": "^1.34.0",
    "mailparser": "^3.9.16",
    "multer": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.2.7",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.2.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
